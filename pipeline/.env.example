# --- LLM (any OpenAI-compatible endpoint; default is Google AI Studio's free tier) ---
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Sources that need keys (all optional; a source without a key is skipped) ---
SERPER_API_KEY=            # https://serper.dev  (Google results; 2,500 free credits total, budgeted in config/search.yaml)
ADZUNA_APP_ID=             # https://developer.adzuna.com
ADZUNA_APP_KEY=
JOOBLE_API_KEY=            # https://jooble.org/api/about

# --- Notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paths (optional overrides; defaults are relative to the repo) ---
# AUTOJOB_DATA_DIR=./data
# AUTOJOB_OUTPUT_DIR=./output
# AUTOJOB_PROFILE_DIR=./profile
# AUTOJOB_CONFIG=./config/search.yaml
